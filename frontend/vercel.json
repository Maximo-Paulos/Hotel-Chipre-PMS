{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/funciones",
      "destination": "funciones.html"
    },
    {
      "source": "/precios",
      "destination": "precios.html"
    },
    {
      "source": "/faq",
      "destination": "faq.html"
    },
    {
      "source": "/pms-hotelero",
      "destination": "pms-hotelero.html"
    },
    {
      "source": "/software-para-hoteles",
      "destination": "software-para-hoteles.html"
    },
    {
      "source": "/terms",
      "destination": "terms.html"
    },
    {
      "source": "/privacy",
      "destination": "privacy.html"
    },
    {
      "source": "/contacto",
      "destination": "contacto.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
