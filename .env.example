# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT (SQLite local)
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///./dev-local.db
APP_BASE_URL=http://127.0.0.1:8040
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8040/api
VITE_PUBLIC_SITE_URL=https://hotels-pms.com
VITE_PUBLIC_APP_URL=https://app.hotels-pms.com
VITE_PUBLIC_APP_HOSTNAME=app.hotels-pms.com
VITE_ALLOW_INDEXING=false

# "Iniciar sesion con Google" (login), ambas son el mismo OAuth Client ID
# publico (no secreto): crealo en Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application, con
# https://app.hotels-pms.com y http://localhost:5173 como "Authorized
# JavaScript origins" (no hace falta redirect URI, este flujo no usa uno).
# Si se deja vacio, el boton de Google simplemente no aparece.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ═══════════════════════════════════════════════════════════════════
# PRODUCTION — Supabase PostgreSQL
# Obtené la URL en: Project Settings > Database > Connection string
# Formato "URI mode" (usar el puerto 5432 directo o 6543 para pooler)
# ═══════════════════════════════════════════════════════════════════
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# APP_BASE_URL=https://<tu-servicio>.onrender.com
# FRONTEND_URL=https://app.hotels-pms.com

# Auth — generá con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-antes-de-deploy

# PIN de manager (mínimo 6 dígitos, distinto de 1234)
MANAGER_PIN=123456

# Clave Fernet para cifrar credentials de integraciones (PayPal, MercadoPago, Gmail)
# Solo es obligatoria si activas alguna de esas integraciones en producción.
# Generá con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATIONS_ENCRYPTION_KEY=

# CORS — URLs del frontend público y app en Vercel
# CORS_ORIGINS=https://hotels-pms.com,https://app.hotels-pms.com

# Email transaccional del sistema
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SYSTEM_EMAIL_FROM="Hotel Chipre PMS <noreply@auth.hotels-pms.com>"
SYSTEM_EMAIL_REPLY_TO=hotelxpms@gmail.com

# Pagos (opcionales para MVP)
# MERCADOPAGO_WEBHOOK_SECRET solo es obligatorio si MP_ACCESS_TOKEN o las credenciales OAuth de Mercado Pago están configuradas.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MERCADOPAGO_WEBHOOK_SECRET=

# OAuth/redirect URLs solo se validan si la integración está realmente configurada.
PAYPAL_REDIRECT_URI=http://127.0.0.1:8040/api/integrations/oauth/paypal/callback
MERCADOPAGO_REDIRECT_URI=http://127.0.0.1:8040/api/integrations/oauth/mercadopago/callback

# Gmail OAuth sigue existiendo solo para integraciones de hotel, no para el mail del sistema.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8040/api/integrations/oauth/gmail/callback

# OTA (opcionales)
BOOKING_USERNAME=
BOOKING_PASSWORD=
EXPEDIA_API_KEY=
EXPEDIA_HOTEL_ID=

# Analytics IA provider. Set AI_PROVIDER=gemma for your own rig or AI_PROVIDER=openai for OpenAI API.
AI_ENABLED=true
AI_PROVIDER=gemma
AI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
AI_MODEL=gemma2:2b
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.2
AI_STRICT_JSON=true
AI_MONTHLY_QUOTA=20

# Legacy Gemma variables remain supported by the global Gemma assistant.
GEMMA_ENABLED=false
GEMMA_PROVIDER=disabled
GEMMA_ENDPOINT_URL=
GEMMA_MODEL=
# Ruta relativa al root del repo (se crea sola si no existe)
ANALYTICS_EXPORTS_DIR=./var/exports/analytics
PAYMENT_PROOFS_DIR=./var/payment-proofs

# ═══════════════════════════════════════════════════════════════════
# Runtime / entorno
# ═══════════════════════════════════════════════════════════════════
# development | production — en production se validan secretos fuertes al arrancar
APP_ENV=development

# Política central de efectos externos. Deben declararse explícitamente en
# producción. Cuando EXTERNAL_EFFECTS_ENABLED=false, el runtime exige el perfil
# cerrado completo antes de arrancar y no lee credenciales de proveedores.
EXTERNAL_EFFECTS_ENABLED=false
INBOUND_PROVIDER_EVENTS_ENABLED=false
GOOGLE_LOGIN_ENABLED=false

# ═══════════════════════════════════════════════════════════════════
# Auth avanzada (defaults razonables; obligatorios y fuertes en producción)
# ═══════════════════════════════════════════════════════════════════
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
LOGIN_RATE_LIMIT=5
# Deben ser distintos entre sí en producción
ACCESS_TOKEN_SECRET=
SIGNED_TOKEN_SECRET=

# ═══════════════════════════════════════════════════════════════════
# Master admin panel (obligatorio configurar en producción)
# ═══════════════════════════════════════════════════════════════════
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
# Alias soportado: MANAGER_PIN (ver arriba). Mínimo 6 dígitos, nunca 1234.
# MASTER_ADMIN_PIN=
MASTER_ADMIN_SESSION_SECRET=
MASTER_ADMIN_SESSION_TTL_MINUTES=480
MASTER_ADMIN_IDLE_TTL_MINUTES=480
MASTER_ADMIN_MAX_ATTEMPTS=5
MASTER_ADMIN_LOCKOUT_MINUTES=15
# true/false; por defecto se deriva del esquema https de APP_BASE_URL
# MASTER_ADMIN_COOKIE_SECURE=

# ═══════════════════════════════════════════════════════════════════
# Identidad del hotel y negocio
# ═══════════════════════════════════════════════════════════════════
HOTEL_NAME=Hotel PMS
HOTEL_TIMEZONE=America/Argentina/Buenos_Aires
DEFAULT_DEPOSIT_PERCENT=30.0
DEFAULT_SUBSCRIPTION_PLAN=starter
SUBSCRIPTION_ENFORCEMENT=false
CONNECTIONS_ENABLED=true

# ═══════════════════════════════════════════════════════════════════
# Pagos — OAuth de integraciones (opcionales)
# ═══════════════════════════════════════════════════════════════════
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ═══════════════════════════════════════════════════════════════════
# Datastores opcionales (deshabilitados por defecto)
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MONGO_ENABLED=false
MONGO_URL=mongodb://localhost:27017
MONGO_DB=hotel_pms
CASSANDRA_ENABLED=false
CASSANDRA_HOSTS=localhost
CASSANDRA_KEYSPACE=hotel_pms

# Cache de read-models (availability/analytics)
READ_MODEL_CACHE_ENABLED=true
READ_MODEL_AVAILABILITY_TTL_SECONDS=15
READ_MODEL_ANALYTICS_TTL_SECONDS=60
DISTRIBUTED_LOCK_ENABLED=true
# Required in production; local development can fall back to PostgreSQL row locks.
DISTRIBUTED_LOCK_REQUIRED=false
DISTRIBUTED_LOCK_DEFAULT_TTL_SECONDS=60
REALTIME_EVENTS_ENABLED=true
REALTIME_EVENTS_HEARTBEAT_SECONDS=15

# Warehouse derivado (PostgreSQL sigue siendo la fuente de verdad)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_REQUIRED=false
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=hotel_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_SECONDS=5

# ═══════════════════════════════════════════════════════════════════
# OTA endpoints (defaults de producción de cada proveedor)
# ═══════════════════════════════════════════════════════════════════
BOOKING_API_URL=https://supply-xml.booking.com/hotels/xml
EXPEDIA_API_URL=https://services.expediapartnercentral.com

# Dev: escribe códigos de verificación/reset a un archivo local en vez de mandar emails
DEV_EMAIL_OUTBOX_PATH=
