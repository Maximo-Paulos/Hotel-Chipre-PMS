.claude/worktrees/

# graphify: keep the portable graph core in-repo, ignore machine-local/regenerable state
graphify-out/
.graphify/cache/
.graphify/description-instructions/
.graphify/label-instructions/
.graphify/branch.json
.graphify/worktree.json
.graphify/.graphify_describe_pending

# Local QA browser state and large/non-sensitive binary evidence
.qa/
artifacts/qa/

# Keep Obsidian portable preferences only; ignore machine/session/layout state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/cache/
knowledge/.obsidian/workspace.json
knowledge/.obsidian/workspace-mobile.json
knowledge/.obsidian/graph.json
knowledge/.obsidian/cache/

