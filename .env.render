# Sample env for Render. Copy these values into the Render dashboard.

APP_ENV=production
APP_BASE_URL=https://<render-service>.onrender.com
FRONTEND_URL=https://app.hotels-pms.com
CORS_ORIGINS=https://hotels-pms.com,https://app.hotels-pms.com
EXTERNAL_EFFECTS_ENABLED=false
INBOUND_PROVIDER_EVENTS_ENABLED=false
CONNECTIONS_ENABLED=false
REALTIME_EVENTS_ENABLED=true
GOOGLE_LOGIN_ENABLED=false
APPLE_LOGIN_ENABLED=false

DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
JWT_SECRET=<generate-a-strong-secret>
MANAGER_PIN=<6+digits-not-1234>
INTEGRATIONS_ENCRYPTION_KEY=<generate-a-fernet-key>

EMAIL_PROVIDER=null
RESEND_API_KEY=
SYSTEM_EMAIL_FROM="Hotel Chipre PMS <noreply@auth.hotels-pms.com>"
SYSTEM_EMAIL_REPLY_TO=hotelxpms@gmail.com

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://<render-service>.onrender.com/api/integrations/oauth/gmail/callback

AI_ENABLED=false
AI_PROVIDER=disabled
GEMMA_ENABLED=false
GEMMA_PROVIDER=disabled
PAYPAL_MODE=sandbox
